    "test:smoke": "playwright test --grep @smoke",
    "test:performance": "node tests/performance/load.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
